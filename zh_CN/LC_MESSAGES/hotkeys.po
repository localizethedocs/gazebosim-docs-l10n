#: ../../../hotkeys.md:1
msgid "Gazebo Keyboard Shortcuts"
msgstr ""

#: ../../../hotkeys.md:3
msgid "<div style=\"display: table\">\n"
msgstr ""

#: ../../../hotkeys.md:7
msgid ""
"  <table cellspacing='0'> <!-- cellspacing='0' is important, must stay -->\n"
msgstr ""

#: ../../../hotkeys.md:9
msgid ""
"  <tr><th>Action</th><th>Operation</th><th>Instruction</th></tr><!-- Table "
"Header -->\n"
msgstr ""

#: ../../../hotkeys.md:11
msgid "  <tr><th colspan=\"3\" class=\"sub\"><b>MODE</b></th></tr>\n"
msgstr ""

#: ../../../hotkeys.md:13
msgid ""
"  <tr><td>Enter Selection mode (default mode)</td><td>Esc</td><td>press "
"\"Esc\" for Select (model) mode</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:15
msgid ""
"  <tr><td>Enter Rotate mode</td><td>r</td><td>press \"r\" for Rotate (model) "
"mode</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:17
msgid ""
"  <tr><td>Enter Translate mode</td><td>t</td><td>press \"t\" for Translate "
"(model) mode</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:19
msgid ""
"  <tr><td>Pause / unpause</td><td>Space</td><td>press the space bar to "
"pause / unpause</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:21
msgid "  <!--Manipulating Models section -->\n"
msgstr ""

#: ../../../hotkeys.md:23
msgid ""
"  <tr><th colspan=\"3\" class=\"sub\"><b>MANIPULATING MODELS</b></th></tr>\n"
msgstr ""

#: ../../../hotkeys.md:25
msgid ""
"  <tr><td>Rotate model</td><td>r</td><td>press \"r\" for Rotate mode; click "
"a model & rotate it using markers</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:27
msgid ""
"  <tr><td>Translate model</td><td>t</td><td>press \"t\" for Translate mode; "
"click a model & translate it using markers</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:29
msgid ""
"  <tr><td>Constrain along axis</td><td>x/y/z</td><td>hold key while "
"manipulating a model to constrain movement along that axis</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:31
msgid ""
"  <tr><td>Snap when rotating</td><td>Ctrl + drag</td><td>hold Ctrl while "
"rotating a model to rotate in customizable increments (default is 45° but "
"can be changed from Transform Control GUI)</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:33
msgid ""
"  <tr><td>Snap when translating</td><td>Ctrl + drag</td><td>hold Ctrl while "
"translating a model to move in customizable increments (default is 1m but "
"can be changed from Transform Control GUI)</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:35
msgid ""
"  <tr><td>Align to world frame</td><td>Shift</td><td>hold Shift while "
"manipulating a model to temporarily align axis its to the world frame</td></"
"tr>\n"
msgstr ""

#: ../../../hotkeys.md:37
msgid "  <tr><th colspan=\"3\" class=\"sub\"><b>MAIN WINDOW</b></th></tr>\n"
msgstr ""

#: ../../../hotkeys.md:39
msgid ""
"  <tr><td>Save Config</td><td>Ctrl + s</td><td>hold Ctrl and press \"s\" to "
"save the current window configuration</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:41
msgid ""
"  <tr><td>Save Config As</td><td>Ctrl + Shift + s</td><td>hold Ctrl and "
"Shift, and press \"s\" to save the current window configuration to a "
"designated location</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:43
msgid ""
"  <tr><td>Load Config</td><td>Ctrl + o</td><td>hold Ctrl and press \"o\" to "
"load a window configuration</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:45
msgid ""
"  <tr><td>Close</td><td>Ctrl + q</td><td>hold Ctrl and press \"q\" to shut "
"down Gazebo</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:47
msgid ""
"  <tr><td>Search Menu</td><td>/</td><td>press \"/\" to open the search menu "
"for plugins</td></tr>\n"
msgstr ""

#: ../../../hotkeys.md:49
msgid "</table>\n"
msgstr ""

#: ../../../hotkeys.md:53
msgid "</div>\n"
msgstr ""
