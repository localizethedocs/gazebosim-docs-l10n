msgstr ""

#: ../../../ros2_interop.md:81
msgid ""
"Configure a bridge between ROS topic `/joint_states` and Gazebo topic `/"
"world/demo/model/diff_drive/joint_state` by adding remappings in the node "
"setup or by creating a [bridge.yaml](https://github.com/gazebosim/"
"ros_gz_project_template/blob/main/ros_gz_example_bringup/config/"
"ros_gz_example_bridge.yaml):"
msgstr ""

#: ../../../ros2_interop.md:83
msgid ""
"- ros_topic_name: \"/joint_states\"\n"
"  gz_topic_name: \"/world/demo/model/diff_drive/joint_state\"\n"
"  ros_type_name: \"sensor_msgs/msg/JointState\"\n"
"  gz_type_name: \"gz.msgs.Model\"\n"
"  direction: GZ_TO_ROS\n"
msgstr ""

