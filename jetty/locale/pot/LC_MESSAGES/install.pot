#: ../../../install.md:30
msgid "Building documentation"
msgstr ""

#: ../../../install.md:32
msgid ""
"After completing a source installation, you can build the documentation for "
"the Gazebo libraries from the root of the workspace."
msgstr ""

#: ../../../install.md:35
msgid "Install Doxygen and the documentation dependencies. On Ubuntu:"
msgstr ""

#: ../../../install.md:37
msgid "sudo apt-get install -y doxygen graphviz\n"
msgstr ""

#: ../../../install.md:41
msgid ""
"**Note:** Building documentation for `sdformat` requires the additional "
"`texlive-latex-extra` package. Install the documentation dependencies with:"
msgstr ""

#: ../../../install.md:44
msgid "sudo apt-get install -y doxygen graphviz texlive-latex-extra\n"
msgstr ""

#: ../../../install.md:48
msgid "Then run:"
msgstr ""

#: ../../../install.md:50
msgid ""
"colcon build --merge-install \\\n"
"  --cmake-args -DBUILD_TESTING=OFF \\\n"
"  --cmake-target doc\n"
msgstr ""

#: ../../../install.md:56
msgid "The generated documentation for each library can be found under:"
msgstr ""

#: ../../../install.md:58
msgid "build/<package>/doxygen/html/\n"
msgstr ""

