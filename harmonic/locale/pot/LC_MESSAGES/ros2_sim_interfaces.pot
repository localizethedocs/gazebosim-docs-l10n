msgstr ""

#: ../../../ros2_sim_interfaces.md:0
msgid "`DeleteEntity`"
msgstr ""

#: ../../../ros2_sim_interfaces.md:0
msgid "`/gzserver/delete_entity`"
msgstr ""

#: ../../../ros2_sim_interfaces.md:0
msgid "Delete an existing entity by name"
msgstr ""

#: ../../../ros2_sim_interfaces.md:99
msgid "SpawnEntity Service"
msgstr ""

#: ../../../ros2_sim_interfaces.md:101
msgid "Spawn a new entity in the simulation at a specific location."
msgstr ""

#: ../../../ros2_sim_interfaces.md:103
msgid ""
"ros2 service call /gzserver/spawn_entity simulation_interfaces/srv/"
"SpawnEntity \"{\n"
"  name: 'my_model',\n"
"  uri: '/path/to/model.sdf',\n"
"  allow_renaming: false,\n"
"  initial_pose: {\n"
"    pose: {\n"
"      position: {x: 0.0, y: 0.0, z: 0.0},\n"
"      orientation: {w: 1.0, x: 0.0, y: 0.0, z: 0.0}\n"
"    }\n"
"  }\n"
"}\"\n"
msgstr ""

#: ../../../ros2_sim_interfaces.md:117
msgid "DeleteEntity Service"
msgstr ""

#: ../../../ros2_sim_interfaces.md:119
msgid "Delete an existing entity by name."
msgstr ""

#: ../../../ros2_sim_interfaces.md:121
msgid ""
"ros2 service call /gzserver/delete_entity simulation_interfaces/srv/"
"DeleteEntity \"{entity: 'my_model'}\"\n"
msgstr ""

